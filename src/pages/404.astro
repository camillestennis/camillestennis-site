---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Camille Stennis">
	<div class="wrap nf">
		<p class="eyebrow">404</p>
		<h1 class="mono">$ cd /this-page</h1>
		<p class="mono err">404 Not Found. Nothing lives at this address.</p>
		<a class="btn btn-primary" href="/">Back to the homepage</a>
	</div>
</Base>

<style>
	.nf {
		padding: 8rem 1rem;
	}
	h1 {
		font-size: clamp(1.1rem, 3vw, 1.6rem);
		word-break: break-all;
	}
	.err {
		color: var(--pink);
		margin-bottom: 2rem;
	}
</style>
